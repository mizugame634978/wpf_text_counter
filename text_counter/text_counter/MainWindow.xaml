<Window x:Class="text_counter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:text_counter"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <TextBlock>hello</TextBlock>
            <!-- <TextBox Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /> -->
            <TextBox
                AcceptsReturn="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                Height="100"
                Width="300"
                Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock>文字数：</TextBlock>
            <TextBlock Text="{Binding CharCount}" />
            <TextBlock>単語数：</TextBlock>
            <TextBlock Text="{Binding WordCount}" />
            <TextBlock>行数：</TextBlock>
            <TextBlock Text="{Binding LineCount}" />
        </StackPanel>
    </Grid>
</Window>